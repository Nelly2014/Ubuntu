# Copy to .env (never commit .env)
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Comma-separated staff access codes, one per department or person. Use long random strings.
ACCESS_CODES=change-me-clinic-1,change-me-saps-1
ANTHROPIC_MODEL=claude-sonnet-5-5
PORT=3000
# Set to "true" only if your policy and POPIA assessment allow storing message text in the audit log
LOG_CONTENT=false
# Set to 1 when running behind a reverse proxy or load balancer (Azure, nginx, Cloudflare)
TRUST_PROXY=0
